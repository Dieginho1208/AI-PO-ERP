# Leave empty to run in Demo/Mock mode (no API calls, pre-cached payloads)
ANTHROPIC_API_KEY=
# Any current Claude model ID. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional overrides
ERP_DB_PATH=data/erp.db
ERP_IMPORT_DIR=erp_import
PRICE_TOLERANCE=0.01
MATCH_CONFIDENCE_THRESHOLD=85
